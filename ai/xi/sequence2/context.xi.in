# A named current topic overrides an earlier text topic. Follow-ups without a
# named topic retain history. This is explicit native context policy, not an
# answer supplied by the host or a change to the learned text weights.
label c2_text_context
load64 r0 @C+16
cmp r0 0
jle c2_text_context_done
load64 r8 @C+8
set r9 0
label c2_text_topic_scan
cmp r9 r8
jge c2_text_context_done
mov r0 r9
mul r0 8
add r0 @T
load64 r10 $r0
set r11 0
label c2_text_known_topic
load64 r0 @C+500
cmp r11 r0
jge c2_text_topic_next
mov r0 r11
mul r0 8
add r0 @C+512
load64 r0 $r0
cmp r10 r0
je c2_text_current_topic
add r11 1
jmp c2_text_known_topic
label c2_text_topic_next
add r9 1
jmp c2_text_topic_scan
label c2_text_current_topic
store64 @C+16 0
call c1_encode_input
label c2_text_context_done
ret
