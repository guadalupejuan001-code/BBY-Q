jne invalid
load8 r0 8100000000000004000
cmp r0 0
jne invalid
store8 8100000000000004000 87
store8 8100000000000004001 0
store8 8100000000000004002 255
store8 8100000000000004003 0
store8 8100000000000004004 0
store8 8100000000000004005 0
store8 8100000000000004006 0
store8 8100000000000004007 0
store8 8100000000000004700 0
store8 8100000000000004701 1
