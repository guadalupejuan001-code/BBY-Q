cmp r0 81
jne fail
load8 r0 8100000000000001000
cmp r0 0
je fresh
jmp fail
label fresh
store8 8100000000000001000 86
store8 8100000000000001001 0
store8 8100000000000001002 255
store8 8100000000000001003 0
store8 8100000000000001004 0
store8 8100000000000001005 0
store8 8100000000000001006 0
store8 8100000000000001007 0
store8 8100000000000001500 1
store8 8100000000000001501 0
set r0 86
print r0
halt
label fail
div r0 0
