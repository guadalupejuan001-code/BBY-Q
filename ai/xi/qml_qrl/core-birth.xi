#!reverse-pc-machine-v1
# BBY Q / ciclo 1. Tabla fija Q15 decimal: cos(k*pi/4), escala 10000.
# Los valores son aproximaciones redondeadas; NO amplitudes arbitrarias.
load8 r0 8100000000000000000
cmp r0 0
je core_new
div r0 0
label core_new
store8 8100000000000000000 81
store8 8100000000000000001 1
store8 8100000000000000100 32
store8 8100000000000000101 78
store8 8100000000000000102 175
store8 8100000000000000103 66
store8 8100000000000000104 16
store8 8100000000000000105 39
store8 8100000000000000106 113
store8 8100000000000000107 11
store8 8100000000000000108 0
store8 8100000000000000109 0
store8 8100000000000000110 113
store8 8100000000000000111 11
store8 8100000000000000112 16
store8 8100000000000000113 39
store8 8100000000000000114 175
store8 8100000000000000115 66
set r0 81
print r0
halt
