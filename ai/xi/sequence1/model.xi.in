# Exact token frames and sparse learned readout. All inference/SGD runs in XI.
# The prior QChat100 Clifford circuit is reused without changing its state map.
label c1_frame
# FRAME_IMPLEMENTATION

# Append an exact feature (family r0, integer value r1) to F or G.
label c1_append
mul r0 %FEATURE_STRIDE%
add r0 r1
load64 r2 @C+280
load64 r3 @C+288
cmp r3 1024
jge c1_feature_overflow
mov r4 r3
mul r4 8
add r4 r2
store64 $r4 r0
add r3 1
store64 @C+288 r3
ret
label c1_feature_overflow
store64 @C+184 3
ret

label c1_encode_input
store64 @C+184 1
load64 r0 @C+8
cmp r0 0
jlt c1_input_bad
cmp r0 256
jgt c1_input_bad
load64 r0 @C+16
cmp r0 0
jlt c1_input_bad
cmp r0 64
jgt c1_input_bad
store64 @C+24 0
store64 @C+32 0
store64 @C+288 0
store64 @C+280 @F
label c1_input_loop
load64 r0 @C+24
cmp r0 2
jge c1_input_done
cmp r0 0
jne c1_history_count
load64 r1 @C+8
set r2 @T
set r3 @TL
jmp c1_input_counted
label c1_history_count
load64 r1 @C+16
set r2 @H
set r3 @HL
label c1_input_counted
load64 r4 @C+32
cmp r4 r1
jge c1_next_section
mov r5 r4
mul r5 8
add r2 r5
load64 r6 $r2
cmp r6 1
jlt c1_input_bad
cmp r6 1048576
jge c1_input_bad
store64 @FRAME r6
set r6 0
cmp r4 0
je c1_previous_ready
sub r2 8
load64 r6 $r2
label c1_previous_ready
store64 @FRAME+8 r6
store64 @FRAME+16 r4
store64 @FRAME+24 r0
store64 @FRAME+32 0
store64 @FRAME+40 0
store64 @FRAME+48 0
add r3 r5
load64 r6 $r3
store64 @FRAME+56 r6
store64 @FRAME+64 0
call c1_frame
load64 r0 @C+184
cmp r0 1
jne c1_input_done
load64 r0 @MEASURED+24
mul r0 3
load64 r1 @MEASURED
call c1_append
load64 r1 @MEASURED+8
cmp r1 0
je c1_no_pair
mul r1 1048576
load64 r2 @MEASURED
add r1 r2
load64 r0 @MEASURED+24
mul r0 3
add r0 1
call c1_append
label c1_no_pair
load64 r1 @MEASURED+16
mul r1 1048576
load64 r2 @MEASURED
add r1 r2
load64 r0 @MEASURED+24
mul r0 3
add r0 2
call c1_append
load64 r0 @C+32
add r0 1
store64 @C+32 r0
jmp c1_input_loop
label c1_next_section
load64 r0 @C+24
add r0 1
store64 @C+24 r0
store64 @C+32 0
jmp c1_input_loop
label c1_input_bad
store64 @C+184 4
label c1_input_done
load64 r0 @C+288
store64 @C+40 r0
ret

# A cache is opaque exact measured features, shared by a prompt's token labels.
label c1_cache_input
load64 r0 @C+128
load64 r1 @C+40
store64 $r0 r1
mov r3 r0
add r3 8
load64 r4 @C+8
store64 $r3 r4
add r3 8
load64 r4 @C+16
store64 $r3 r4
set r2 0
label c1_cache_loop
cmp r2 r1
jge c1_cache_done
mov r3 r2
mul r3 8
add r3 @F
load64 r4 $r3
mov r3 r2
mul r3 8
add r3 24
add r3 r0
store64 $r3 r4
add r2 1
jmp c1_cache_loop
label c1_cache_done
ret
label c1_load_input
load64 r0 @C+128
load64 r1 $r0
store64 @C+40 r1
mov r3 r0
add r3 8
load64 r4 $r3
store64 @C+8 r4
add r3 8
load64 r4 $r3
store64 @C+16 r4
set r2 0
label c1_load_loop
cmp r2 r1
jge c1_load_done
mov r3 r2
mul r3 8
add r3 24
add r3 r0
load64 r4 $r3
mov r3 r2
mul r3 8
add r3 @F
store64 $r3 r4
add r2 1
jmp c1_load_loop
label c1_load_done
ret

# Output IDs and positions have exact fields; no hash and no clipping below 64.
label c1_copy_input
load64 r1 @C+40
set r2 0
label c1_active_copy
cmp r2 r1
jge c1_active_ready
mov r0 r2
mul r0 8
add r0 @F
load64 r3 $r0
mov r0 r2
mul r0 8
add r0 @G
store64 $r0 r3
add r2 1
jmp c1_active_copy
label c1_active_ready
store64 @C+288 r1
store64 @C+280 @G
ret
label c1_prefix
call c1_copy_input
store64 @FRAME 0
store64 @FRAME+8 0
store64 @FRAME+16 0
store64 @FRAME+24 2
load64 r0 @C+88
store64 @FRAME+32 r0
load64 r0 @C+96
store64 @FRAME+40 r0
load64 r0 @C+104
store64 @FRAME+48 r0
store64 @FRAME+56 0
store64 @FRAME+64 0
call c1_frame
load64 r0 @C+184
cmp r0 1
jne c1_prefix_done
set r0 6
load64 r1 @MEASURED+32
call c1_append
set r0 7
load64 r1 @MEASURED+40
call c1_append
set r0 8
load64 r1 @MEASURED+48
call c1_append
set r0 9
load64 r1 @MEASURED+40
mul r1 128
load64 r2 @MEASURED+32
add r1 r2
call c1_append
load64 r0 @C+288
store64 @C+48 r0
load64 r1 @C+192
cmp r1 2
jne c1_prefix_done
store64 @C+48 0
label c1_prefix_done
ret

label c1_cache_prefix
load64 r0 @C+320
load64 r1 @C+48
load64 r2 @C+40
sub r1 r2
store64 $r0 r1
set r3 0
label c1_cache_prefix_loop
cmp r3 r1
jge c1_cache_prefix_done
mov r4 r3
add r4 r2
mul r4 8
add r4 @G
load64 r5 $r4
mov r4 r3
mul r4 8
add r4 8
add r4 r0
store64 $r4 r5
add r3 1
jmp c1_cache_prefix_loop
label c1_cache_prefix_done
ret
label c1_load_prefix
call c1_copy_input
load64 r0 @C+320
load64 r1 $r0
load64 r2 @C+40
set r3 0
label c1_load_prefix_loop
cmp r3 r1
jge c1_load_prefix_done
mov r4 r3
mul r4 8
add r4 8
add r4 r0
load64 r5 $r4
mov r4 r3
add r4 r2
mul r4 8
add r4 @G
store64 $r4 r5
add r3 1
jmp c1_load_prefix_loop
label c1_load_prefix_done
add r2 r1
store64 @C+48 r2
ret

# Preserve r10..r13 and f25, as in the original native binary-tree learner.
# All exact features remain available. Weakly share pair/position evidence so
# one training wording cannot dominate a familiar word in a new wording.
# r6 receives the exact feature family; f23 returns its fixed coefficient.
label c1_feature_scale
fset f23 1
cmp r6 6
jge c1_scale_output
mod r6 3
cmp r6 0
je c1_scale_done
fset f23 .15
ret
label c1_scale_output
fset f23 2
cmp r6 8
jne c1_scale_done
fset f23 .5
label c1_scale_done
ret

label c1_logit
load64 r14 @C+56
mul r14 %HEAD_STRIDE%
add r14 @W
mov r0 r10
sub r0 1
mul r0 %NODE_STRIDE%
add r14 r0
mov r0 r10
sub r0 1
mul r0 8
load64 r1 @C+56
mul r1 1024
add r0 r1
add r0 @BIAS
fload f20 $r0
load64 r8 @C+48
set r7 0
label c1_dot
cmp r7 r8
jge c1_sigmoid
mov r0 r7
mul r0 8
add r0 @G
load64 r1 $r0
mov r6 r1
div r6 %FEATURE_STRIDE%
call c1_feature_scale
mul r1 8
add r1 r14
fload f0 $r1
fmul f0 f23
fadd f20 f0
add r7 1
jmp c1_dot
label c1_sigmoid
fmax f20 -15
fmin f20 15
fmov f21 f20
fmul f21 -1
fexp f21 f21
fadd f21 1
fset f0 1
fdiv f0 f21
fmov f21 f0
ret

label c1_train
load64 r12 @C+64
set r10 1
load64 r0 @C+56
set r13 64
cmp r0 0
je c1_train_node
set r13 8
label c1_train_node
call c1_logit
mov r11 r12
div r11 r13
mod r11 2
itof f22 r11
fsub f22 f21
fload f0 @C+112
fmul f22 f0
load64 r8 @C+48
itof f0 r8
fdiv f0 20
fadd f0 1
fdiv f22 f0
set r7 0
label c1_train_weight
cmp r7 r8
jge c1_train_bias
mov r0 r7
mul r0 8
add r0 @G
load64 r1 $r0
mov r6 r1
div r6 %FEATURE_STRIDE%
call c1_feature_scale
mul r1 8
add r1 r14
fload f0 $r1
fmov f24 f22
fmul f24 f23
fadd f0 f24
fstore $r1 f0
add r7 1
jmp c1_train_weight
label c1_train_bias
mov r0 r10
sub r0 1
mul r0 8
load64 r1 @C+56
mul r1 1024
add r0 r1
add r0 @BIAS
fload f0 $r0
fadd f0 f22
fstore $r0 f0
mul r10 2
add r10 r11
div r13 2
cmp r13 0
jgt c1_train_node
load64 r0 @C+56
mul r0 8
add r0 @C+224
load64 r1 $r0
add r1 1
store64 $r0 r1
ret

label c1_next
set r10 1
set r13 64
set r12 0
load64 r0 @C+56
cmp r0 0
je c1_next_begin
set r13 8
label c1_next_begin
fset f25 0
label c1_next_node
call c1_logit
set r11 0
fcmp f21 0.5
jle c1_next_chosen
mov r0 r12
add r0 r13
load64 r1 @C+56
mul r1 8
add r1 @C+208
load64 r1 $r1
cmp r0 r1
jge c1_next_chosen
set r11 1
label c1_next_chosen
fmov f0 f21
cmp r11 1
je c1_next_log
fset f0 1
fsub f0 f21
label c1_next_log
fmax f0 0.000000000001
flog f0 f0
fadd f25 f0
mov r0 r11
mul r0 r13
add r12 r0
mul r10 2
add r10 r11
div r13 2
cmp r13 0
jgt c1_next_node
store64 @C+72 r12
print r12
femit log_probability f25
ret
